# Shared local configuration. Copy this file to .env once at repository root.

# Backend -------------------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

DATA_BACKEND=local
PIPELINE_BACKEND=mock
LOCAL_DATABASE_PATH=data/gensticker.sqlite3
LOCAL_ASSET_ROOT=storage
ALLOW_LOCAL_DEMO_AUTH=true
MOCK_STAGE_SECONDS=0.6
MAX_UPLOAD_BYTES=10485760
TEMP_ASSET_TTL_SECONDS=86400
MAX_REGENERATIONS_PER_SOURCE=2
MIN_PUBLISHABLE_OUTPUTS=6
TARGET_OUTPUTS=8

# Production remains blocked until a reviewed real adapter and approved policy
# baselines are configured. Never place provider secrets in EXPO_PUBLIC_* vars.
QUALITY_BASELINE_VERSION=
SAFETY_POLICY_VERSION=
REPORT_RETENTION_DAYS=

# Required only when DATA_BACKEND=supabase. Never expose the service-role key
# through an EXPO_PUBLIC_* variable or commit a real value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Only required for Supabase projects still issuing legacy HS256 JWTs.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET_SOURCE=source-images
SUPABASE_STORAGE_BUCKET_OUTPUT=generated-stickers

# Mobile --------------------------------------------------------------------
# FastAPI origin reachable from the device; do not append /api/v1.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# Use local only for a development build backed by DATA_BACKEND=local.
EXPO_PUBLIC_AUTH_MODE=local

# Leave both empty to use local X-Device-ID authentication (MVP default).
EXPO_PUBLIC_SUPABASE_URL=
# Preferred for current Supabase projects. Safe to expose in the mobile bundle.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_CONSENT_VERSION=mvp-vi-v1

# API Keys ------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://direct.shopaikey.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1.5
