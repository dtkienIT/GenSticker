# Backend Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/gensticker.db
ASSET_ROOT=./data/assets
ASSET_STORE=auto
# Fill these to use PostgreSQL + private Supabase Storage instead of local files.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=gensticker-assets
MAX_UPLOAD_BYTES=10485760
MIN_IMAGE_WIDTH=160
MIN_IMAGE_HEIGHT=160
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192
DEV_AUTH_ENABLED=true
DEFAULT_DEV_USER_ID=local-dev-user
# One-person research pipeline: InsightFace -> InstantID/SDXL -> BiRefNet -> RGBA.
STICKER_PROVIDER=instantid
STICKER_DEVICE=cuda
STICKER_SEGMENTER_DEVICE=auto
INSTANTID_REPO_PATH=./models/InstantID
SDXL_MODEL_PATH=./models/sdxl-base
INSTANTID_MODEL_PATH=./models/instantid
CANNY_CONTROLNET_MODEL_PATH=./models/controlnet-canny-sdxl
INSIGHTFACE_MODEL_ROOT=./models/insightface
CHIBI_LORA_PATH=./models/lora/StickersRedmond.safetensors
BIREFNET_MODEL_PATH=./models/birefnet
BIREFNET_INPUT_SIZE=512
STICKER_OUTPUT_SIZE=1024
STICKER_OUTLINE_PX=15
STICKER_MASK_THRESHOLD=32
STICKER_FACE_DETECTION_SIZE=640
STICKER_REFERENCE_CROP_SCALE=2.35
STICKER_CANNY_LOW_THRESHOLD=60
STICKER_CANNY_HIGH_THRESHOLD=160
STICKER_HAIR_DARK_THRESHOLD=95
STICKER_IP_ADAPTER_SCALE=0.48
STICKER_IDENTITY_CONTROL_SCALE=0.45
STICKER_HAIR_CONTROL_SCALE=0.55
STICKER_HAIR_CONTROL_END=0.85
STICKER_INFERENCE_STEPS=30
STICKER_GUIDANCE_SCALE=4.8
STICKER_LORA_SCALE=1.25
STICKER_TONE_TARGET_P95=225
STICKER_TONE_MIN_GAIN=0.82
STICKER_TONE_DESATURATION=0.06
JOB_POLL_INTERVAL_MS=500
STALE_JOB_SECONDS=120
MAX_JOB_RETRIES=2
MAX_GPU_SECONDS_PER_JOB=500
GPU_COST_PER_SECOND_USD=0.000075
LOG_LEVEL=INFO
ASSET_TTL_HOURS=168

# Mobile App Configuration
EXPO_PUBLIC_STICKER_SERVICE=http
EXPO_PUBLIC_USE_MOCK_SERVICE=false
# Leave empty for automatic Metro LAN host discovery on a physical device.
# Android emulator: http://10.0.2.2:8000/api/v1
# Web/iOS simulator: http://127.0.0.1:8000/api/v1
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_DEV_USER_ID=local-dev-user
EXPO_PUBLIC_ENABLE_DEV_TOOLS=true
EXPO_PUBLIC_DEFAULT_LOCALE=vi
