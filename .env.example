# ==========================================
# ⚡ GENSTICKER AI - ENVIRONMENT VARIABLES EXAMPLE
# Copy file này thành `.env` tại thư mục gốc
# ==========================================

# --- DATABASE & SUPABASE ---
# Kết nối PostgreSQL Database (Supabase Pooler hoặc Direct Connection)
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Thông tin Supabase Credentials (Lấy từ Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET=stickers

# --- AI GENERATION & BACKEND CONFIG ---
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_LOCAL_DEMO_AUTH=false
GENERATION_RATE_LIMIT_PER_HOUR=3
MAX_ACTIVE_GENERATIONS=2
MAX_RETAINED_JOBS=4
JOB_TTL_SECONDS=3600
ASSET_ROOT=./data/assets

# Sticker generation API (backend only; never expose in frontend variables)
FAL_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5

# --- TELEGRAM BOT CONFIG ---
# Bot Token lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_sticker_bot_username
