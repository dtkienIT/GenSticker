# Backend Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/gensticker.db
ASSET_ROOT=./data/assets
MAX_UPLOAD_BYTES=10485760
MIN_IMAGE_WIDTH=256
MIN_IMAGE_HEIGHT=256
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192
DEV_AUTH_ENABLED=true
DEFAULT_DEV_USER_ID=local-dev-user
GENERATION_PROVIDER=mock
COMFYUI_ENABLED=false
COMFYUI_BASE_URL=http://host.docker.internal:8188
JOB_POLL_INTERVAL_MS=500
STALE_JOB_SECONDS=120
MAX_JOB_RETRIES=2
MAX_GPU_SECONDS_PER_JOB=500
MOCK_COST_PER_SECOND_USD=0.00019
MOCK_GENERATION_DELAY_MS=500
LOG_LEVEL=INFO
ASSET_TTL_HOURS=168

# Mobile App Configuration
EXPO_PUBLIC_STICKER_SERVICE=mock
EXPO_PUBLIC_USE_MOCK_SERVICE=true
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_DEV_USER_ID=local-dev-user
EXPO_PUBLIC_ENABLE_DEV_TOOLS=true
EXPO_PUBLIC_DEFAULT_LOCALE=vi
EXPO_PUBLIC_WEB_MODEL_SOURCE=local
EXPO_PUBLIC_WEB_MODEL_BASE_URL=http://127.0.0.1:8790/
