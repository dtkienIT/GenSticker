{
  "expo": {
    "name": "Duhat Gen Sticker",
    "slug": "duhat-gen-sticker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "duhatgensticker",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "vn.duhat.gensticker",
      "infoPlist": {
        "NSCameraUsageDescription": "Duhat Gen Sticker cần camera để bạn chụp ảnh nguồn tạo sticker.",
        "NSPhotoLibraryUsageDescription": "Duhat Gen Sticker cần quyền chọn một ảnh nguồn từ thư viện của bạn."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.duhat.gensticker",
      "permissions": ["CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Duhat Gen Sticker chọn một ảnh nguồn của bạn.",
          "cameraPermission": "Cho phép Duhat Gen Sticker dùng camera để chụp ảnh nguồn.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
