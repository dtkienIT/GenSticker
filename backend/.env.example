# Provider Selection: "gemini" (default), "cloudflare", or "openai"
AI_PROVIDER=gemini

# Google Gemini API Config
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Workers AI Config (Optional if AI_PROVIDER=cloudflare)
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_api_token_here
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CF_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# OpenAI Config (Optional if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_VISION_MODEL=gpt-4o-mini
