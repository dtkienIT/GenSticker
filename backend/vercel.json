{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{**/tests/**,**/__pycache__/**,**/*.test.py,fixtures/**,testdata/**}"
    }
  }
}
